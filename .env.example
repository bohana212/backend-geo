# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Admin Auth ────────────────────────────────────────────────────────────────
MASTER_API_KEY="ganti-dengan-secret-panjang-min-32-karakter"

# ── Encryption for Bot Tokens ─────────────────────────────────────────────────
# Generate: openssl rand -hex 32
ENCRYPTION_KEY="64-karakter-hex-dari-openssl-rand-hex-32"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Pisahkan dengan koma. Pakai * untuk semua origin.
ALLOWED_ORIGINS="*"

# ── Admin Telegram Notifikasi (Opsional) ──────────────────────────────────────
# Bot token & chat ID yang menerima notifikasi aksi admin & tracker
NOTIFY_BOT_TOKEN=""
NOTIFY_CHAT_ID=""
